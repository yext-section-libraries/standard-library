{
  "name": "yext-standard-library",
  "version": "0.0.0",
  "description": "A Yext Pages Section Library containing the original 'out-of-the-box' sections.",
  "author": "sprumo@yext.com",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "dev": "SECTION_LIBRARY_REVISION_ID=local pages dev",
    "prod": "pages prod",
    "build": "pages build",
    "lint": "oxlint --react-plugin --deny-warnings .",
    "lint:fix": "oxlint --fix --react-plugin --deny-warnings .",
    "prettier": "prettier --write --cache .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run ./src/testing/*.test.tsx",
    "test:components": "SECTION_LIBRARY_REVISION_ID=local vitest run ./src/testing/*.test.tsx",
    "generate-notices": "generate-license-file --input package.json --output ./THIRD-PARTY-NOTICES --overwrite",
    "validate": "yextve validate",
    "deploy": "yextve deploy",
    "convert-template": "yextve convert-template --apply --delete-source",
    "add-directory-locator": "yextve add-directory-locator"
  },
  "engines": {
    "node": ">=20.18.2"
  },
  "dependencies": {
    "@puckeditor/core": "0.22.2",
    "@yext/search-headless-react": "^2.7.1",
    "@yext/search-ui-react": "^3.0.1",
    "awesome-phonenumber": "^7.8.0",
    "lucide-react": "^0.414.0",
    "mapbox-gl": "^3.20.0",
    "react": "^18.2.0",
    "react-collapsed": "^4.1.2",
    "react-dom": "^18.2.0",
    "react-i18next": "^15.5.2",
    "react-icons": "^5.2.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.4.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.2.77",
    "@types/react-dom": "^18.2.25",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/browser": "^3.2.4",
    "@yext/pages": "1.3.2",
    "@yext/pages-components": "2.2.0",
    "@yext/visual-editor": "https://github.com/asanehisa/public-assets/raw/main/yext-visual-editor-1.4.8.tgz",
    "autoprefixer": "^10.4.8",
    "generate-license-file": "^3.6.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^24.1.1",
    "oxlint": "1.2.0",
    "pixelmatch": "^7.2.0",
    "playwright": "1.55.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.32",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.3.3",
    "vite": "^5.4.21",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "vite": {
      "rollup": "npm:@rollup/wasm-node"
    }
  }
}
