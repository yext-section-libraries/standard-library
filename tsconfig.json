{
  "compilerOptions": {
    "target": "ESNext",
    "strict": true,
    "moduleResolution": "Bundler",
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "rootDir": "./src",
    "outDir": "./dist",
    "skipLibCheck": true,
    "module": "esnext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "paths": {
      "@yext/pages": ["./node_modules/@yext/pages/dist/types/src/index.d.ts"]
    }
  },
  "include": ["src", "global.d.ts", "theme.config.ts"],
  "exclude": [
    "src/library/.generated",
    "src/templates/local-editor*.tsx",
    "src/templates/edit-*.tsx",
    "src/templates/yext-standard-library*.tsx"
  ]
}
