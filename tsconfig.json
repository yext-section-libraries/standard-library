{
  "compilerOptions": {
    "target": "ESNext",
    "strict": true,
    "moduleResolution": "Bundler",
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "esnext",
    "paths": {
      "@yext/pages": ["./node_modules/@yext/pages/dist/types/src/index.d.ts"]
    },
    "types": ["vite/client"],
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true,
    "declaration": true,
  },
  "include": ["src", "global.d.ts", "theme.config.ts"]
}
